# Copy to deployment/.env. Never commit .env.
#
#   cp .env.example .env
#   python -c "import secrets; print('qm-' + secrets.token_urlsafe(32))"
#
# docker compose reads this file automatically from the directory it runs in.

# Comma-separated API keys. REQUIRED - compose refuses to start without it.
#
# An empty value is not the same as no auth: the gateway refuses every request
# rather than serving an open endpoint, so a typo here fails closed.
QM_API_KEYS=

# Which serve config the gateway runs. `serve/production.yaml` uses the vLLM
# backend, so it needs the gpu profile. For a stack with no GPU, point this at
# a config with an echo or transformers backend.
QM_SERVE_CONFIG=serve/production.yaml

QM_LOG_LEVEL=INFO

# Host ports for nginx. Change if 80/443 are already taken.
QM_HTTP_PORT=80
QM_HTTPS_PORT=443
