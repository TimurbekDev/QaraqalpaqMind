# The chat UI. Next.js standalone output, no source and no build tooling.
#
# Build from the REPOSITORY ROOT:
#     docker build -f deployment/Dockerfile.web -t qaraqalpaqmind-web .

FROM node:22-alpine AS deps

WORKDIR /app
# Lockfile-only install first, so editing a component does not reinstall the
# dependency tree.
COPY web/package.json web/package-lock.json ./
# `npm ci` not `npm install`: it installs exactly the lockfile and fails if
# package.json disagrees, which is what makes a build reproducible.
RUN npm ci


FROM node:22-alpine AS builder

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./

# NEXT_PUBLIC_* variables are inlined into the client bundle at build time.
# None are used here, and none should be: the only secret this app holds is the
# gateway key, which is read at REQUEST time in the server-side route handler.
# A build argument for it would bake it into the image.
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build


FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# node:alpine already ships a `node` user (uid 1000). Reusing it is one less
# thing to keep in sync than creating another.
USER node

# The standalone bundle contains its own minimal node_modules. `static` and
# `public` are not included in it and must be copied separately - miss them and
# the app serves HTML with no CSS or JS, which looks like a broken build rather
# than a missing COPY.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

EXPOSE 3000

# Against the container's own hostname, not loopback: a server bound to
# 127.0.0.1 answers a loopback check and is unreachable from nginx, so a
# localhost healthcheck reports healthy for a container nothing can reach.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "const h=require('os').hostname();fetch(`http://${h}:3000/`).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# server.js is generated by the standalone build; there is no `next` binary in
# this image.
CMD ["node", "server.js"]
