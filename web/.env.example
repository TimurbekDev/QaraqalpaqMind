# Copy to .env.local. Never commit .env.local.

# The model gateway. Reached from the Next.js SERVER, not the browser, so this
# can be an internal hostname: use http://api:8000 inside the compose network.
QM_API_URL=http://localhost:8000

# Key for the gateway.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_. Anything so prefixed is inlined
# into the JavaScript bundle at build time and is readable by every visitor.
# This key buys GPU time; it must stay on the server.
QM_API_KEY=

# The id sent to the gateway, matching `served_model_name` in the serve config.
QM_MODEL=qaraqalpaqmind
