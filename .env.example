# Copy to .env and fill in. Never commit .env.

# --- Paths (override only if data lives outside the repo, e.g. on a big disk) ---
QM_DATA_DIR=
QM_MODELS_DIR=
QM_LOGS_DIR=

# --- Logging ---
QM_LOG_LEVEL=INFO
QM_LOG_JSON=false

# --- Crawling etiquette (Phase 2) ---
QM_USER_AGENT=QaraqalpaqMindBot/0.1 (+https://github.com/<you>/QaraqalpaqMind; contact@example.com)
QM_CRAWL_CONCURRENCY=4
QM_CRAWL_DELAY_SECONDS=1.5

# --- Hugging Face (Phase 5+) ---
HF_TOKEN=

# Where Hugging Face stores downloaded models and datasets.
#
# LEAVE THIS UNSET ON A LAPTOP, SET IT ON A CLOUD GPU. The default is
# ~/.cache/huggingface, which on a container is the ephemeral overlay
# filesystem - a 16 GB Qwen3-8B download is then lost on every pod restart and
# re-downloaded on every run. Point it at the persistent volume instead:
#   HF_HOME=/workspace/.cache/huggingface
HF_HOME=

# Same reasoning: Triton compiles kernels on first use and caches them.
# TRITON_CACHE_DIR=/workspace/.cache/triton

# Silences a fork warning emitted once per dataloader worker. Tokenisation
# happens before the dataloader starts, so parallelism there buys nothing.
TOKENIZERS_PARALLELISM=false

# --- Experiment tracking (Phase 5+) ---
WANDB_API_KEY=
WANDB_PROJECT=qaraqalpaqmind
WANDB_MODE=offline

# --- RAG (Phase 9) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Serving (Phase 10) ---
QM_API_HOST=0.0.0.0
QM_API_PORT=8000
QM_VLLM_URL=http://localhost:8001/v1
QM_JWT_SECRET=change-me-to-a-long-random-string
QM_RATE_LIMIT=60/minute
