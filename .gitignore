*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Secrets / local env ---
.env
.env.local
*.pem
*.key
secrets/

# --- Data (tracked via manifests + DVC/HF Hub, never via git) ---
data/raw/**
data/interim/**
data/processed/**
data/datasets/**
