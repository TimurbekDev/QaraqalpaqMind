wandb/
runs/
outputs/
*.log

# --- Node / Next.js ---
node_modules/
web/.next/
web/out/
web/.turbo/
next-env.d.ts

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Docker / infra local state ---
deployment/**/volumes/
qdrant_storage/
